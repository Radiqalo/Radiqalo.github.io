.dropdown-btn::before {
        content: '';
        position: absolute;
        top: -100%;
        left: 0;
        width: 100%;
        height: 100%;
        background-color: grey;
        transition: top 0.3s ease-out;
        z-index: 1;
}

.dropdown-btn:hover::before {
        top: 0;
}

.dropdown-btn::after {
        content: '';
        position: absolute;
        top: -100%;
        left: 0;
        width: 100%;
        height: 100%;
        background-color: #2196F3;
        transition: top 0.2s ease-out;
        z-index: 0;
}

.dropdown-btn:hover::after {
        top: 0;
}