        <p style="font-family: 'Noto Sans SC';">Noto Sans SC</p>
        <p style="font-family: 'Noto Serif SC';">Noto Serif SC</p>
        <p style="font-family: 'Cascadia Next SC';">Cascadia Next SC</p>
        <p style="font-family: 'Lexend';">Lexend</p>
        <p style="font-family: 'InterVariable';">Inter</p>
        <p style="font-family: 'Jost';">Jost</p>
        <p style="font-family: 'ZSFT-hq';">ZSFT-hq</p>
        <p style="font-family: 'Sans-Normalcy';">Sans-Normalcy</p>
</Layout>
