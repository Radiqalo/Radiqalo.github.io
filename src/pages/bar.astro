    <title>导航栏 + 同高下拉菜单</title>
</head>
<body>
    <nav class="nav">
        <div class="navbar-title">产品管理系统</div>
        <div class="menu-group">
            <TopMenu title="产品操作 A">
                <li><a href="#" class="menu-item">查看详情</a></li>
                <li><a href="#" class="menu-item">加入收藏</a></li>
            </TopMenu>
            <TopMenu title="产品操作 B">
                <li><a href="#" class="menu-item">分享产品</a></li>
                <li><a href="#" class="menu-item">联系客服</a></li>
                <li><a href="#" class="menu-item">删除</a></li>
            </TopMenu>
            <TopMenu title="产品操作 C">
                <li><a href="#">属性设置</a></li>
                <li><a href="#">属性设置</a></li>
                <li><a href="#">属性设置</a></li>
                <li><a href="#">属性设置</a></li>
                <li><a href="#">属性设置</a></li>
