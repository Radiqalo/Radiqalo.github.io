---
import Social from "./Social.astro";
---

<footer>
        <div class="footer">
                <div style="width: 50px;height: 50px;background-color: cyan;">
                </div>
                <span class="iconify" data-icon="mdi:home" data-inline="false"
                ></span>
                <div class="tooltip" data-tip="Bilibili">
                        <a href="www.bilibili.com"></a>
                </div>
                <symbol id="lucide--menu" viewBox="0 0 24 24"
                        ><path
                                fill="none"
                                stroke="currentColor"
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                stroke-width="2"
                                d="M4 5h16M4 12h16M4 19h16"></path>
                </symbol>

                <svg
                        xmlns="http://www.w3.org/2000/svg"
                        width="24"
                        height="24"
                        viewBox="0 0 24 24"
                        ><use href="#lucide--menu"></use></svg
                >
        </div>
        <div class="licence">
                <p></p>
        </div>
</footer>
